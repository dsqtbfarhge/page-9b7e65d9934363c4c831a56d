:#f0f0f0;font-weight:500;margin-bottom:6px}\n.clients .cell .os{font-size:12px;color:var(--mute2);letter-spacing:1px;text-transform:uppercase;margin-bottom:14px}\n.clients .cell .note{font-size:13px;color:var(--mute)}\n@media(max-width:760px){\n  .clients{grid-template-columns:repeat(2,1fr)}\n}\n.faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line)}\n.faq{background:var(--ink);padding:28px 26px}\n.faq h3{margin:0 0 12px;font-size:16px;font-weight:500;color:#f0f0f0;line-height:1.4}\n.faq p{margin:0;color:var(--mute);font-size:14px}\n.faq .tag{display:inline-block;font-size:11px;color:var(--neon);letter-spacing:1px;text-transform:uppercase;margin-bottom:10px}\n@media(max-width:760px){\n  .faq-grid{grid-template-columns:1fr}\n}\n.foot{padding:36px 0 48px;font-size:13px;color:var(--mute2);display:flex;justify-content:space-between;flex-wrap:wrap;gap:18px}\n.foot a{color:var(--mute)}\n</style><header class=\"nav\">\n  <div class=\"nav-inner\">\n    <a href=\"#top\" class=\"brand-mark\">Stashbox</a>\n    <nav class=\"nav-links\" aria-label=\"主导航\">\n      <a href=\"#overview\">服务概览</a>\n      <a href=\"#usage\">使用步骤</a>\n      <a href=\"#plans\">订阅套餐</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</header>\n\n<main id=\"top\">\n\n<section class=\"wrap hero\">\n  <div>\n    <h1>Stashbox<br><span class=\"accent\">可订阅的网络代理节点服务</span></h1>\n    <p class=\"lede\">Stashbox 提供基于订阅的网络代理与节点路由服务，按月或按年选购合适的流量套餐，支持多台设备同时在线，配合通用客户端即可完成配置。</p>\n    <div class=\"meta-row\">\n      <span><b>3 档</b>流量套餐</span>\n      <span><b>3 / 5 / 20</b>设备同时在线</span>\n      <span><b>100GB 起</b>月度流量</span>\n      <span><b>月付 / 年付</b>计费方式</span>\n    </div>\n  </div>\n  <aside class=\"panel\">\n    <h3>服务基本信息</h3>\n    <dl>\n      <dt>服务名称</dt><dd>Stashbox</dd>\n      <dt>交付方式</dt><dd>订阅链接 + 通用客户端</dd>\n      <dt>计费周期</dt><dd>月付 / 年付</dd>\n      <dt>设备上限</dt><dd>按套餐 3 / 5 / 20 台</dd>\n      <dt>流量配额</dt><dd>100 / 300 / 1000 GB 每月</dd>\n      <dt>客服支持</dt><dd>工单系统</dd>\n    </dl>\n    <div class=\"cta\">\n      <span>查看下方 <strong>订阅套餐</strong> 选购合适档位</span>\n      <a href=\"#plans\">前往 →</a>\n    </div>\n  </aside>\n</section>\n\n<section class=\"wrap section\" id=\"overview\">\n  <div class=\"eyebrow\">01 / 服务概览</div>\n  <h2>一份订阅，对应一组节点</h2>\n  <p class=\"sub\">Stashbox 将节点配置封装为单一订阅链接，导入兼容的客户端后即可在多平台使用。订阅内的节点、流量与设备上限随套餐档位调整，按月或按年刷新。</p>\n  <div class=\"three-col\">\n    <div class=\"item\">\n      <div class=\"num\">// 01</div>\n      <h3>订阅链接交付</h3>\n      <p>完成订阅后获得一条可复制的链接，导入客户端后自动同步节点信息，更新节点时无需重复配置。</p>\n    </div>\n    <div class=\"item\">\n      <div class=\"num\">// 02</div>\n      <h3>多设备配额</h3>\n      <p>同一订阅可在套餐允许的设备数量内同时在线，便于在手机、电脑与平板之间切换使用。</p>\n    </div>\n    <div class=\"item\">\n      <div class=\"num\">// 03</div>\n      <h3>月度流量计量</h3>\n      <p>每月按套餐档位提供固定的可用流量额度，超出部分按所选套餐规则处理，可在工单内查询明细。</p>\n    </div>\n  </div>\n</section>\n\n<section class=\"wrap section\" id=\"usage\">\n  <div class=\"eyebrow\">02 / 使用步骤</div>\n  <h2>从订阅到上线的四个步骤</h2>\n  <p class=\"sub\">以下流程描述了 Stashbox 订阅从选购到在客户端中生效的一般顺序，具体客户端操作以对应软件说明为准。</p>\n  <div class=\"timeline\">\n    <ol>\n      <li>\n        <h4>选购套餐并获取订阅链接</h4>\n        <p>在订阅套餐区域选择合适的月付或年付档位，完成支付后系统会展示一条以 https 开头的订阅地址。</p>\n      </li>\n      <li>\n        <h4>在客户端中添加订阅</h4>\n        <p>打开兼容的代理客户端，进入订阅或配置页面，将上述链接粘贴至订阅地址栏并保存。</p>\n      </li>\n      <li>\n        <h4>更新节点列表</h4>\n        <p>在客户端中触发一次订阅更新，节点列表会按当前套餐内容刷新，并按设备上限生效。</p>\n      </li>\n      <li>\n        <h4>选择节点并启用</h4>\n        <p>从节点列表中选中可用节点，开启系统代理或按客户端指引启用本地代理，即可开始使用。</p>\n      </li>\n    </ol>\n    <div class=\"side\">\n      <h3>订阅链接示例</h3>\n      <p>实际链接由服务后台生成，下方仅为格式示意：</p>\n      <code>https://example.com/sub?token=xxxxxxxx</code>\n      <p>请将整段地址复制到客户端的订阅项中，避免截断或包含多余空格。</p>\n    </div>\n  </div>\n</section>\n\n<section class=\"wrap section\" id=\"plans\">\n  <div class=\"eyebrow\">03 / 订阅套餐</div>\n  <h2>按用量与设备数选择档位</h2>\n  <p class=\"sub\">三档套餐覆盖个人轻度、深度与团队协作三种典型使用场景，按月或按年计费，年付相对月付在总价上更划算。</p>\n  <div class=\"plans-wrap\">\n    <table class=\"plans\">\n      <thead>\n        <tr>\n          <th class=\"feat\">项目</th>\n          <th>基础版</th>\n          <th>旗舰版</th>\n          <th>团队版</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td class=\"plan-name\">月付价格</td>\n          <td>\n            <span class=\"price\">¥15<small> /月</small></span>\n            <span class=\"annual\">按年付仅需 ¥150/年</span>\n          </td>\n          <td>\n            <span class=\"price\">¥35<small> /月</small></span>\n            <span class=\"annual\">按年付仅需 ¥350/年</span>\n          </td>\n          <td>\n            <span class=\"price\">¥85<small> /月</small></span>\n            <span class=\"annual\">按年付仅需 ¥850/年</span>\n          </td>\n        </tr>\n        <tr>\n          <td class=\"plan-name\">每月流量</td>\n          <td>100 GB</td>\n          <td>300 GB</td>\n          <td>1000 GB</td>\n        </tr>\n        <tr>\n          <td class=\"plan-name\">设备同时在线</td>\n          <td>3 台</td>\n          <td>5 台</td>\n          <td>20 台</td>\n        </tr>\n        <tr class=\"featured\">\n          <td class=\"plan-name\">套餐内容</td>\n          <td>\n            <ul>\n              <li>每月 100GB 极速流量</li>\n              <li>支持 3 台设备同时在线</li>\n              <li>解锁基础流媒体</li>\n              <li>普通线路节点池</li>\n            </ul>\n          </td>\n          <td>\n            <ul>\n              <li>每月 300GB 极速流量</li>\n              <li>支持 5 台设备同时在线</li>\n              <li>全节点原生流媒体解锁</li>\n              <li>IPLC 专线游戏加速优化</li>\n              <li>7x24 优先工单支持</li>\n            </ul>\n          </td>\n          <td>\n            <ul>\n              <li>每月 1000GB 极速流量</li>\n              <li>支持 20 台设备同时在线</li>\n              <li>VIP 专属高带宽节点</li>\n              <li>支持企业定制路由</li>\n              <li>专属客户经理服务</li>\n            </ul>\n          </td>\n        </tr>\n        <tr>\n          <td class=\"plan-name\">计费方式</td>\n          <td>月付 / 年付</td>\n          <td>月付 / 年付</td>\n          <td>月付 / 年付</td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n</section>\n\n<section class=\"wrap section\" id=\"clients\">\n  <div class=\"eyebrow\">04 / 客户端</div>\n  <h2>配合通用代理客户端使用</h2>\n  <p class=\"sub\">Stashbox 通过标准订阅链接交付节点配置，可在使用相同订阅协议的开源或通用客户端中导入并使用，跨平台覆盖常见桌面与移动系统。</p>\n  <div class=\"clients\">\n    <div class=\"cell\">\n      <div class=\"name\">桌面客户端 A</div>\n      <div class=\"os\">Windows / macOS / Linux</div>\n      <p class=\"note\">在订阅设置中粘贴订阅链接，更新后从节点列表选择线路即可。</p>\n    </div>\n    <div class=\"cell\">\n      <div class=\"name\">桌面客户端 B</div>\n      <div class=\"os\">Windows / macOS</div>\n      <p class=\"note\">支持系统代理与 TUN 模式，按需在客户端设置中开启对应模式。</p>\n    </div>\n    <div class=\"cell\">\n      <div class=\"name\">移动客户端</div>\n      <div class=\"os\">iOS / Android</div>\n      <p class=\"note\">在配置或订阅页面导入链接，更新节点后选择合适的服务器。</p>\n    </div>\n    <div class=\"cell\">\n      <div class=\"name\">命令行工具</div>\n      <div class=\"os\">Linux / 服务器</div>\n      <p class=\"note\">适用于在路由器或服务器上以守护进程方式运行的命令行实现。</p>\n    </div>\n  </div>\n</section>\n\n<section class=\"wrap section\" id=\"faq\">\n  <div class=\"eyebrow\">05 / 常见问题</div>\n  <h2>订阅、流量与设备相关问题</h2>\n  <p class=\"sub\">以下为选购与使用 Stashbox 订阅过程中较常遇到的问题，具体工单处理结果以服务后台答复为准。</p>\n  <div class=\"faq-grid\">\n    <article class=\"faq\">\n      <span class=\"tag\">订阅</span>\n      <h3>订阅链接在哪里查看？</h3>\n      <p>完成支付后，订阅链接会显示在订单详情页面以及用户中心的订阅项中，整段以 https 开头，可直接复制使用。</p>\n    </article>\n    <article class=\"faq\">\n      <span class=\"tag\">流量</span>\n      <h3>每月流量是如何计算的？</h3>\n      <p>流量按自然月重置，以客户端实际产生的上行与下行总和为准，统计周期与所选套餐的计费方式一致。</p>\n    </article>\n    <article class=\"faq\">\n      <span class=\"tag\">设备</span>\n      <h3>超过设备上限会怎样？</h3>\n      <p>同时在线的设备数量超过套餐上限时，最早接入的设备会被自动下线，可在客户端中重新登录恢复使用。</p>\n    </article>\n    <article class=\"faq\">\n      <span class=\"tag\">计费</span>\n      <h3>月付和年付可以切换吗？</h3>\n      <p>在订阅有效期内可切换计费方式，未使用的月付余额按比例折算，年付到期前会按当时价格续费，可在到期前关闭自动续费。</p>\n    </article>\n    <article class=\"faq\">\n      <span class=\"tag\">节点</span>\n      <h3>节点列表什么时候更新？</h3>\n      <p>节点信息会不定期调整，每次更新后可在客户端中手动触发订阅更新，已保存的本地配置不会被覆盖。</p>\n    </article>\n    <article class=\"faq\">\n      <span class=\"tag\">支持</span>\n      <h3>遇到问题如何联系？</h3>\n      <p>可通过用户中心的工单入口提交问题，旗舰版与团队版享受优先处理顺序，工作日内通常会有较快响应。</p>\n    </article>\n  </div>\n</section>\n\n</main>\n\n<footer class=\"wrap foot\">\n  <div>© Stashbox · 节点订阅服务说明</div>\n  <div>\n    <a href=\"#overview\">服务概览</a> ·\n    <a href=\"#plans\">订阅套餐</a> ·\n    <a href=\"#faq\">常见问题</a>\n  </div>\n</footer>",
